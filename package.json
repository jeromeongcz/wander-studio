{
  "name": "wander-ai-director",
  "private": true,
  "version": "0.0.0",
  "description": "Standalone local-first multilingual faceless video studio",
  "workspaces": [
    "app/*"
  ],
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "test": "npm test -w @wander/server",
    "typecheck": "npm run typecheck -w @wander/server && npm run typecheck -w @wander/web",
    "dev:server": "node app/server/src/server.ts",
    "build:web": "npm run build -w @wander/web",
    "dev:web": "npm run dev -w @wander/web",
    "seed:demo": "node scripts/seed-demo.mjs",
    "start": "npm run build:web && npm run dev:server"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "saxes": "6.0.0"
  }
}
